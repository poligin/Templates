{
  "$schema": "https://poligin.dev/schemas/policy-template-v1.json",
  "schema_version": "poligin/v1",
  "kind": "PolicyTemplate",
  "template_key": "zero-trust-credential-guardrail",
  "name": "Zero-Trust Secret & Credential Exfiltration Guardrail",
  "description": "High-priority deny override blocking any access, read, or exfiltration of sensitive identity files, private cryptographic keys, and credential stores.",
  "metadata": {
    "author": "Poligin Community",
    "difficulty": "intermediate",
    "category": "security-guardrails"
  },
  "roles": [
    "*"
  ],
  "groups": [
    "*"
  ],
  "actions": [
    "*"
  ],
  "resources": [
    "*.pem",
    "*.key",
    "*id_rsa*",
    "*id_ed25519*",
    "*/.ssh/*",
    "*/.aws/credentials",
    "*/.env",
    "*/secrets.yaml",
    "*/vault/*"
  ],
  "effect": "deny",
  "priority": 999,
  "conditions": ""
}
